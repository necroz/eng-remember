# Copy to .env and fill in. Everything here has a working default except
# BOT_TOKEN, which the bot refuses to start without.

# --- Telegram ---------------------------------------------------------------
# Get one from @BotFather.
BOT_TOKEN=

# --- Database ---------------------------------------------------------------
# Credentials for the Postgres container. The defaults are for local work only:
# change all three before a public deployment, and keep DATABASE_URL in sync.
POSTGRES_USER=eng
POSTGRES_PASSWORD=eng
POSTGRES_DB=eng_remember
# Host port the database is published on. It is bound to 127.0.0.1 only.
POSTGRES_PORT=55432
# Used by host-side tools (make run, make migrate). Matches the port published
# by docker-compose.yml; if you change the credentials above, change them here
# as well.
DATABASE_URL=postgresql+asyncpg://eng:eng@localhost:55432/eng_remember
# Set to true to print every SQL statement. Only for local debugging: statements
# carry the text learners typed.
DB_ECHO=false
# Connection pool. Handlers hold a session while they wait for a model answer, so
# pool_size + max_overflow must cover BOT__TASKS_CONCURRENCY_LIMIT (20) plus the
# reminder tick, digest and pruner that connect on their own. 10 + 15 = 25.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15

# --- Backups ----------------------------------------------------------------
# Used by the `backup` service (docker compose --profile backup). It keeps this
# many most recent dump files, not days of history: one dump per day, so the two
# coincide while the job runs daily. The default is 7.
BACKUP_KEEP_DAYS=7

# --- LLM --------------------------------------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, DeepSeek, vLLM,
# Ollama. Leave LLM__API_KEY empty and the bot falls back to the rule-based
# parser, which understands "word - translation" lines.
LLM__ENABLED=true
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=
LLM__MODEL=gpt-4o-mini
# Optional standby provider. When the primary route fails (dead key, exhausted
# provider quota, outage, unusable answer), the bot retries the same request on
# the standby and logs llm_failover_used. The bot's own per-learner and global
# limits are policy, not provider health, and are never bypassed this way.
# Leave LLM__FALLBACK_API_KEY empty to disable the standby. Endpoint and model
# default to the primary's when omitted; limits/retries/timeouts are shared.
LLM__FALLBACK_BASE_URL=
LLM__FALLBACK_API_KEY=
LLM__FALLBACK_MODEL=
# Extra HTTP headers as a JSON object. Some gateways route on a header of their
# own: OpenCode Go requires {"x-opencode-session": "<any stable id>"}. Headers
# do not cross hosts: a standby with its own LLM__FALLBACK_BASE_URL gets only
# LLM__FALLBACK_EXTRA_HEADERS, while one on the same host reuses the primary's.
LLM__EXTRA_HEADERS={}
LLM__FALLBACK_EXTRA_HEADERS={}
LLM__TEMPERATURE=0.0
# Structured JSON does not need chain-of-thought. Empty (the default) sends no
# parameter at all, so providers that do not know it never return 400 and a
# reasoning model applies its own default. Set "none" to keep the output budget
# for the answer, or low/medium/high to keep some reasoning; if the provider
# rejects the parameter once, the process remembers and drops it automatically.
LLM__REASONING_EFFORT=
LLM__RETRIES=2
# Reasoning models spend time thinking before the first token; a discovery
# batch of 28 cards can take 30-60 seconds.
LLM__TIMEOUT_SECONDS=120
# Tokens one answer may spend, reasoning included. A reasoning model can spend
# the whole budget thinking and return empty content, so this must cover both
# the reasoning and the JSON. 1500 is not enough for a full discovery batch.
LLM__MAX_OUTPUT_TOKENS=8000
# Per-learner cost limits: interactive calls, example generation calls and
# tokens in any rolling 24 hours. Exceeding any of them refuses the call before
# it is made, so a limited account spends nothing. 0 disables the check. These
# are the free-tier defaults; a separate paid deployment can raise them with
# environment variables. Per-user plan overrides inside one bot are a separate
# feature.
LLM__MAX_CALLS_PER_DAY=60
LLM__MAX_EXAMPLE_CALLS_PER_DAY=30
LLM__MAX_TOKENS_PER_DAY=100000
# Bot-wide budget: warn at the percentage below, stop all model calls at 100%.
# The warning goes to BOT__ADMIN_CHAT_ID when it is set, and always to the log.
LLM__MAX_TOKENS_PER_DAY_GLOBAL=2000000
LLM__GLOBAL_ALERT_PERCENT=80

# --- Scheduling -------------------------------------------------------------
# Probability of recall the scheduler aims for. 0.9 is the FSRS default;
# raise it for shorter intervals and better retention.
SRS__DESIRED_RETENTION=0.9
SRS__MAXIMUM_INTERVAL_DAYS=365
# Scatters intervals slightly so cards learned together do not stay clumped.
SRS__ENABLE_FUZZING=true

# --- Review -----------------------------------------------------------------
# A correct answer is graded "easy" only if it arrives faster than this many
# seconds; slower correct answers get "good". The timer includes reading the
# card and typing the answer, so on a phone even a known word takes ~10s; a
# 5-second bar graded almost every correct answer as merely "good".
REVIEW__EASY_THRESHOLD_SECONDS=10

# --- Streaks and freezes ----------------------------------------------------
# A day counts as soon as one card is answered; the bar is about coming back
# daily, not about volume.
STREAK__ENABLED=true
# Freezes given to a brand-new learner, so the mechanic is discoverable early.
STREAK__FREEZE_INITIAL=1
STREAK__FREEZE_MAX=3
# One freeze is earned every N consecutive days. 0 disables earning.
STREAK__FREEZE_EVERY_DAYS=7

# --- Reminders --------------------------------------------------------------
# Times are wall-clock in the learner's own timezone. Two slots a day: the
# morning ping goes out when there is something to review; the evening one
# carries whatever is left and, when the streak is at risk, says so in the
# same message. A morning missed while the bot was down is not backfilled
# after the evening.
REMINDERS__ENABLED=true
# How often the bot checks who is due. A tick catches up rather than firing at
# an exact second, so a bot that was down at 08:00 still sends the reminder.
REMINDERS__TICK_SECONDS=600
REMINDERS__DEFAULT_TIME=08:00
REMINDERS__DEFAULT_STREAK_TIME=18:00
# The weekly digest takes the morning slot on this weekday (0 = Monday) and can
# be switched off globally or per learner (/remind digest off).
REMINDERS__DIGEST_WEEKDAY=0
REMINDERS__DIGEST_ENABLED=true
# Learners fetched and decided per query. A tick always walks the whole
# candidate list; this only bounds one query.
REMINDERS__BATCH_SIZE=200

# --- Word discovery ---------------------------------------------------------
# How many words to look for when the user does not say.
DISCOVERY__DEFAULT_COUNT=10
DISCOVERY__MAX_COUNT=30
# Suggestions are asked for with a margin, because words already in the
# collection and words absent from a pasted text are filtered out afterwards.
DISCOVERY__OVERSAMPLE=1.4
# How many times the bot may ask a clarifying question before acting anyway.
DISCOVERY__MAX_CLARIFICATION_ROUNDS=2
# A message at least this long is treated as source text to mine, not as a topic.
DISCOVERY__CONTEXT_TEXT_MIN_LENGTH=200

# --- Bot behaviour ----------------------------------------------------------
BOT__DEFAULT_DECK_NAME=Основная колода
BOT__DEFAULT_TIMEZONE=UTC
BOT__NEW_CARDS_PER_DAY=20
# One review run shows a random number of cards inside this range; the rest of
# the backlog waits for the next run.
BOT__REVIEW_SESSION_MIN_CARDS=15
BOT__REVIEW_SESSION_MAX_CARDS=20
# Bot texts are HTML-only; any other value is a startup error.
BOT__PARSE_MODE=HTML
# Updates processed concurrently per bot process. Model calls for one learner
# are serialized separately; this is the ceiling for the whole process.
BOT__TASKS_CONCURRENCY_LIMIT=20
# Updates processed concurrently for one learner. A burst from one account waits
# here instead of taking every process slot; a waiting update holds no database
# connection, and the per-learner model lock still serializes model calls.
BOT__USER_CONCURRENCY_LIMIT=3
# Per-learner inbound guards. Messages and button presses use separate buckets;
# identical plain text inside the TTL is not processed twice. Answers typed into
# a review or clarification flow are exempt from the message budget, so a long
# review run fits inside a low limit.
BOT__MESSAGES_PER_MINUTE=30
BOT__CALLBACKS_PER_MINUTE=30
BOT__DUPLICATE_MESSAGE_TTL_SECONDS=60
# Optional Telegram chat ID for global budget alerts. Leave commented to log
# them without sending a Telegram message.
# BOT__ADMIN_CHAT_ID=123456789

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# false gives readable coloured output for local work.
LOG_JSON=true
# Stores prompt and answer text of every model call. Off by default: they
# contain whatever the user typed. Metrics are always recorded.
LOG_LLM_PAYLOADS=false
# Audit rows older than this many days are pruned once a day; 0 keeps them
# forever. Reviews are never pruned: the learning history needs them.
# LLM_CALL_RETENTION_DAYS=90
