# Copy to .env and fill in. Everything here has a working default except
# BOT_TOKEN, which the bot refuses to start without.

# --- Telegram ---------------------------------------------------------------
# Get one from @BotFather.
BOT_TOKEN=

# --- Database ---------------------------------------------------------------
# Matches the port published by docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://eng:eng@localhost:55432/eng_remember
# Set to true to print every SQL statement.
DB_ECHO=false

# --- LLM --------------------------------------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, DeepSeek, vLLM,
# Ollama. Leave LLM__API_KEY empty and the bot falls back to the rule-based
# parser, which understands "word - translation" lines.
LLM__ENABLED=true
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=
LLM__MODEL=gpt-4o-mini
LLM__TEMPERATURE=0.0
LLM__RETRIES=2
# Tokens one answer may spend, reasoning included. Reasoning models count their
# thinking against this budget, so a value that is too small comes back with
# empty content — which reads as the model being broken rather than as a limit.
LLM__MAX_OUTPUT_TOKENS=1500
# Per-learner cost limits: model calls in any rolling hour and tokens in any
# rolling 24 hours. Exceeding either refuses the call before it is made, so a
# limited account spends nothing. 0 disables the check.
LLM__MAX_CALLS_PER_HOUR=60
LLM__MAX_TOKENS_PER_DAY=300000

# --- Scheduling -------------------------------------------------------------
# Probability of recall the scheduler aims for. 0.9 is the FSRS default;
# raise it for shorter intervals and better retention.
SRS__DESIRED_RETENTION=0.9
SRS__MAXIMUM_INTERVAL_DAYS=365
# Scatters intervals slightly so cards learned together do not stay clumped.
SRS__ENABLE_FUZZING=true

# --- Streaks and freezes ----------------------------------------------------
# A day counts as soon as one card is answered; the bar is about coming back
# daily, not about volume.
STREAK__ENABLED=true
# Freezes given to a brand-new learner, so the mechanic is discoverable early.
STREAK__FREEZE_INITIAL=1
STREAK__FREEZE_MAX=3
# One freeze is earned every N consecutive days. 0 disables earning.
STREAK__FREEZE_EVERY_DAYS=7

# --- Reminders --------------------------------------------------------------
# Times are wall-clock in the learner's own timezone. The morning ping only goes
# out when there is something to review; the evening one only while the streak
# can still be saved.
REMINDERS__ENABLED=true
# How often the bot checks who is due. A tick catches up rather than firing at
# an exact second, so a bot that was down at 09:00 still sends the reminder.
REMINDERS__TICK_SECONDS=600
REMINDERS__DEFAULT_TIME=09:00
REMINDERS__DEFAULT_STREAK_TIME=20:00
# Learners fetched and decided per query. A tick always walks the whole
# candidate list; this only bounds one query.
REMINDERS__BATCH_SIZE=200

# --- Word discovery ---------------------------------------------------------
# How many words to look for when the user does not say.
DISCOVERY__DEFAULT_COUNT=10
DISCOVERY__MAX_COUNT=30
# Suggestions are asked for with a margin, because words already in the
# collection and words absent from a pasted text are filtered out afterwards.
DISCOVERY__OVERSAMPLE=1.4
# How many times the bot may ask a clarifying question before acting anyway.
DISCOVERY__MAX_CLARIFICATION_ROUNDS=2
# A message at least this long is treated as source text to mine, not as a topic.
DISCOVERY__CONTEXT_TEXT_MIN_LENGTH=200

# --- Bot behaviour ----------------------------------------------------------
BOT__DEFAULT_DECK_NAME=Основная колода
BOT__DEFAULT_TIMEZONE=UTC
BOT__NEW_CARDS_PER_DAY=20
BOT__REVIEWS_PER_SESSION=50
BOT__PARSE_MODE=HTML

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# false gives readable coloured output for local work.
LOG_JSON=true
# Stores prompt and answer text of every model call. Off by default: they
# contain whatever the user typed. Metrics are always recorded.
LOG_LLM_PAYLOADS=false
